rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is superadmin
    function isSuperadmin() {
      return request.auth != null && request.auth.token.email == 'heary@hopetv.asia';
    }

    // Helper function to check if user is admin or superadmin
    function isAdmin() {
      return isSuperadmin() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role in ['admin', 'superadmin']
      );
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Per-user documents that carry the owner's uid in a field (e.g. 'user_id').
    // Stored owner must match for read/update/delete; incoming owner must match
    // for create/update, so a user cannot take over someone else's document.
    function storedOwner(field) {
      return request.auth != null && resource.data[field] == request.auth.uid;
    }

    function incomingOwner(field) {
      return request.auth != null && request.resource.data[field] == request.auth.uid;
    }

    // User roles collection - only superadmin can manage
    match /user_roles/{userId} {
      allow read: if isSuperadmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if isSuperadmin();
    }

    // Pending admin emails - superadmin can manage, users can check their own
    match /pending_admin_emails/{email} {
      allow read: if isSuperadmin() || (request.auth != null && request.auth.token.email == email);
      allow write: if isSuperadmin();
    }

    // Devotionals collection - admins can manage, users can read
    match /devotionals/{devotionalId} {
      allow read: if true; // Anyone can read devotionals
      allow create, update, delete: if isAdmin();
    }

    // User bookmarks - users can manage their own
    match /user_bookmarks/{bookmarkId} {
      allow read, delete: if storedOwner('user_id');
      allow create: if incomingOwner('user_id');
      allow update: if storedOwner('user_id') && incomingOwner('user_id');
    }

    // User profiles - users can manage their own, superadmin can read all
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isSuperadmin();
      allow write: if isOwner(userId);
    }

    // Allow superadmin to list all profiles for user management
    match /profiles/{document=**} {
      allow read: if isSuperadmin();
    }

    // Notes collection - users can manage their own
    match /user_notes/{noteId} {
      allow read, delete: if storedOwner('user_id');
      allow create: if incomingOwner('user_id');
      allow update: if storedOwner('user_id') && incomingOwner('user_id');
    }

    // Sync queue - users can manage their own
    match /sync_queue/{queueId} {
      allow read, delete: if storedOwner('user_id');
      allow create: if incomingOwner('user_id');
      allow update: if storedOwner('user_id') && incomingOwner('user_id');
    }

    // Other per-user collections keyed by a 'user_id' field
    match /user_highlights/{id} {
      allow read, delete: if storedOwner('user_id');
      allow create: if incomingOwner('user_id');
      allow update: if storedOwner('user_id') && incomingOwner('user_id');
    }
    match /bookmarks/{id} {
      allow read, delete: if storedOwner('user_id');
      allow create: if incomingOwner('user_id');
      allow update: if storedOwner('user_id') && incomingOwner('user_id');
    }
    match /reading_progress/{id} {
      allow read, delete: if storedOwner('user_id');
      allow create: if incomingOwner('user_id');
      allow update: if storedOwner('user_id') && incomingOwner('user_id');
    }

    // Bible marks use a camelCase 'userId' field
    match /bible_marks/{id} {
      allow read, delete: if storedOwner('userId');
      allow create: if incomingOwner('userId');
      allow update: if storedOwner('userId') && incomingOwner('userId');
    }

    // Per-user documents whose id is the user's uid
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /user_progress/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /user_settings/{docId} {
      allow read, delete: if isOwner(docId) || storedOwner('user_id');
      allow create: if isOwner(docId) || incomingOwner('user_id');
      allow update: if isOwner(docId) || (storedOwner('user_id') && incomingOwner('user_id'));
    }

    // Bible content - anyone can read, only admins can write (data migration)
    match /bible_versions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bible_books/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bible_verses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}